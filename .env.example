# sitrep: per-home settings and secrets.
# Copy this file to .env and fill in what applies to you. Never commit .env.
# A value left empty uses the default from config.yaml (or switches that feature off).

# --- Your home network ---

# Your router's address. On Windows, run `ipconfig` and look for "Default Gateway".
ROUTER_ADDRESS=192.168.1.1
# A port your router answers on: 80 (its web page) works for most routers.
ROUTER_PORT=80
# Your ISP's name, used in messages like "it could be your NBN line or Belong".
HOME_ISP=
# The carrier whose network your ISP runs on: Telstra, Optus, TPG group, Vocus or
# Aussie Broadband. For example Belong runs on Telstra's network.
HOME_CARRIER=

# Optional: a way for the services sitrep polls to contact you (an email address or a
# web page). It's sent in the User-Agent header of every request. Leave it empty to send none.
SITREP_CONTACT=

# --- Secrets ---

# Cloudflare Radar API token (free, read-only). See the README section "Cloudflare token".
# Without it the Cloudflare Radar tile stays grey and says the token is missing.
CLOUDFLARE_API_TOKEN=

# Telegram alerts (optional). See the README section "Telegram alerts".
# The token comes from @BotFather. To find the chat ID, run:  python -m sitrep telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a link to your dashboard to put in alerts, such as http://ds920:8080
SITREP_DASHBOARD_URL=
